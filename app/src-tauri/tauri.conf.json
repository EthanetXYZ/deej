{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deej",
  "version": "1.0.0",
  "identifier": "com.ethanetxyz.deej",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Hardware volume sliders for Windows",
    "longDescription": "deej Next reads physical sliders from an Arduino and sets per-app volumes on Windows. Compatible with deej firmware and config.yaml."
  }
}
